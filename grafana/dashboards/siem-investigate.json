            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "200"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "severity",
                "rule.id",
                "rule.name",
                "source.ip",
                "user.name",
                "host.name",
                "alert.status",
                "alert.id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "@timestamp": 0,
              "severity": 1,
              "rule.id": 2,
              "rule.name": 3,
              "source.ip": 4,
              "user.name": 5,
              "host.name": 6,
              "alert.status": 7,
              "alert.id": 8
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "low": {
                        "color": "blue",
                        "index": 0
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 1
                      },
                      "high": {
                        "color": "orange",
                        "index": 2
                      },
                      "critical": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rule.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Mở trên SOC console",
                    "url": "/go/alert/${__data.fields[\"alert.id\"]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rule.name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Mở trên SOC console",
                    "url": "/go/alert/${__data.fields[\"alert.id\"]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert.id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
