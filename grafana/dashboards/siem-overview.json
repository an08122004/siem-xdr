                "source.ip",
                "user.name",
                "host.name",
                "agent.id",
                "risk_score",
                "alert.status",
                "message"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "@timestamp": 0,
              "severity": 1,
              "rule.id": 2,
              "rule.name": 3,
              "source.ip": 4,
              "user.name": 5,
              "host.name": 6,
              "agent.id": 7,
              "risk_score": 8,
              "alert.status": 9,
              "message": 10
            }
          }
        }
      ],
