#!/bin/sh
# Script active response của SOC Platform cho Wazuh agent Linux (tên lệnh siem-xdr giữ từ trước khi đổi
# tên project, để agent đã cài không phải cài lại).
# Cài vào /var/ossec/active-response/bin/siem-xdr (root:wazuh, 750). SOAR gọi qua Wazuh API:
#   PUT /active-response?agents_list=<id>  {"command": "!siem-xdr", "arguments": [<loại>, <đích>, <action_id>]}
# wazuh-execd đưa 1 dòng JSON vào stdin: {..., "command": "add", "parameters": {"extra_args": [...], ...}}
#
#   block_ip <ip> <id>        chặn IP vào máy (iptables/ip6tables, chain INPUT)
#   unblock_ip <ip> <id>      gỡ chặn
#   kill_process <pid|tên> <id> [tên mong đợi]   (SOAR gửi tên trong alert: PID đã thuộc tiến trình khác thì không kill)
#   isolate_host - <id>       cô lập máy: chỉ còn nói chuyện được với wazuh-manager (để vẫn nhận lệnh gỡ)
#   unisolate_host - <id>
#
# Kết quả ghi 1 dòng vào active-responses.log -> agent gửi về như log thường -> SOAR cập nhật trạng thái lệnh:
#   siem-xdr: action=<id> type=<loại> target=<đích> status=success|failed detail=<mô tả>
# Mọi tham số được kiểm tra chặt (SOAR cũng kiểm tra trước khi gửi); không bao giờ chặn manager, loopback,
# không kill tiến trình của Wazuh / PID 1.
set -u
LOG=/var/ossec/logs/active-responses.log
CONF=/var/ossec/etc/ossec.conf
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

read -r INPUT || true
ARGS=$(printf '%s' "$INPUT" | sed -n 's/.*"extra_args"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' | tr -d '"' | tr ',' ' ')
set -f   # không mở rộng ký tự đại diện khi tách tham số (dữ liệu từ ngoài vào)
# shellcheck disable=SC2086
set -- $ARGS
set +f
TYPE=${1:-}; TARGET=${2:-}; ID=${3:-}; EXPECT=${4:-}
COMMAND=$(printf '%s' "$INPUT" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p')

log() {  # log <success|failed> <mô tả>
    printf '%s siem-xdr: action=%s type=%s target=%s status=%s detail=%s\n' \
        "$(date '+%Y/%m/%d %H:%M:%S')" "$ID" "$TYPE" "$TARGET" "$1" "$2" >> "$LOG"
}
fail() { log failed "$1"; exit 1; }

# id lệnh là hex do SOAR sinh; sai định dạng thì không ghi kết quả (tránh ghi log theo dữ liệu lạ)
printf '%s' "$ID" | grep -Eq '^[0-9a-f]{8,64}$' || exit 1
[ "$COMMAND" = "delete" ] && exit 0   # lệnh do SOAR gửi không có timeout; gỡ chặn là lệnh riêng (unblock_ip)

manager_ips() {
    addr=$(sed -n 's:.*<address>\(.*\)</address>.*:\1:p' "$CONF" | head -n1)
    [ -n "$addr" ] || return 0
    if printf '%s' "$addr" | grep -Eq '^[0-9.]+$|:'; then echo "$addr"; else getent ahosts "$addr" | awk '{print $1}' | sort -u; fi
}

is_ip() {
    printf '%s' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && return 0
    printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f:]{2,39}$' && printf '%s' "$1" | grep -q ':'
}

tree() {  # PID và mọi tiến trình con cháu (theo PPid trong /proc)
    for c in $(awk -v p="$1" '$1 == "PPid:" && $2 == p { split(FILENAME, a, "/"); print a[3] }' /proc/[0-9]*/status 2>/dev/null); do
        tree "$c"
    done
    echo "$1"
}

protected() {  # protected <tên>: không bao giờ kill (Wazuh agent, init / systemd, sshd là kênh quản trị, docker)
    case "$1" in wazuh-*|init|systemd|systemd-*|sshd|sshd-session|sshd-auth|dockerd|containerd*|docker-init) return 0 ;; esac
    return 1
}

comm_of() {  # tên tiến trình (comm, tối đa 15 ký tự), ký tự lạ thành "_" (siem-procs cũng đổi khoảng trắng thành "_")
    tr -d '\n' 2>/dev/null < "/proc/$1/comm" | tr -c 'A-Za-z0-9._:/@+-' '_'
}

alive() {  # alive <pid>: còn chạy (zombie = đã chết, chỉ chờ tiến trình cha thu dọn)
    s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    s=${s##*) }
    [ "${s%% *}" != Z ]
}

ipt() {  # chọn iptables / ip6tables theo địa chỉ
    case "$1" in *:*) echo ip6tables ;; *) echo iptables ;; esac
}

case "$TYPE" in
block_ip|unblock_ip)
    is_ip "$TARGET" || fail "IP không hợp lệ"
    case "$TARGET" in 127.*|::1|0.0.0.0) fail "không chặn địa chỉ loopback" ;; esac
    for m in $(manager_ips); do [ "$m" = "$TARGET" ] && fail "không chặn IP của wazuh-manager"; done
    T=$(ipt "$TARGET")
    if [ "$TYPE" = block_ip ]; then
        "$T" -C INPUT -s "$TARGET" -j DROP 2>/dev/null || "$T" -I INPUT -s "$TARGET" -j DROP 2>/dev/null \
            || fail "$T lỗi (container cần NET_ADMIN)"
        log success "đã chặn $TARGET ($T INPUT DROP)"
    else
        while "$T" -D INPUT -s "$TARGET" -j DROP 2>/dev/null; do :; done
        log success "đã gỡ chặn $TARGET"
    fi
    ;;
kill_process)
    if printf '%s' "$TARGET" | grep -Eq '^[0-9]+$'; then
        [ "$TARGET" -gt 1 ] || fail "không kill PID $TARGET"
        # tiến trình đã tự kết thúc (vd shell chạy rất ngắn) -> mục tiêu "không còn chạy" đã đạt, không phải lỗi
        alive "$TARGET" || { log success "PID $TARGET đã kết thúc trước khi kill, không cần xử lý"; exit 0; }
        NAME=$(comm_of "$TARGET")
        protected "$NAME" && fail "từ chối kill tiến trình hệ thống $NAME"
        if [ -n "$EXPECT" ]; then   # comm chỉ giữ 15 ký tự đầu của tên
            printf '%s' "$EXPECT" | grep -Eq '^[A-Za-z0-9._-]{1,64}$' || fail "tên tiến trình mong đợi không hợp lệ"
            [ "$(printf '%s' "$NAME" | cut -c1-15)" = "$(printf '%s' "$EXPECT" | cut -c1-15)" ] \
                || fail "không kill: PID $TARGET hiện là $NAME, không phải $EXPECT như trong alert (PID có thể đã được cấp lại)"
        fi
        # kill cả cây tiến trình (vd shell của kẻ tấn công và lệnh nó đang chạy), gom hết trước rồi mới kill;
        # tiến trình hệ thống nằm trong cây (vd dịch vụ do shell đó khởi động lại) thì giữ nguyên
        PIDS=""; KEPT=0
        for p in $(tree "$TARGET"); do
            if [ "$p" != "$TARGET" ] && protected "$(comm_of "$p")"; then KEPT=$((KEPT + 1)); continue; fi
            PIDS="$PIDS $p"
        done
        # shellcheck disable=SC2086
        kill -9 $PIDS 2>/dev/null
        # tiến trình con tự thoát trước làm `kill` báo lỗi: chỉ thất bại khi chính PID mục tiêu vẫn còn chạy
        i=0; while alive "$TARGET" && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
        alive "$TARGET" && fail "kill PID $TARGET thất bại"
        # shellcheck disable=SC2086
        N=$(($(echo $PIDS | wc -w) - 1))
        log success "đã kill PID $TARGET ($NAME) và $N tiến trình con$([ "$KEPT" -gt 0 ] && echo ", giữ $KEPT tiến trình hệ thống")"
    else
        printf '%s' "$TARGET" | grep -Eq '^[A-Za-z0-9._-]{1,64}$' || fail "tên tiến trình không hợp lệ"
        protected "$TARGET" && fail "từ chối kill tiến trình hệ thống $TARGET"
        pkill -9 -x "$TARGET" 2>/dev/null && log success "đã kill mọi tiến trình $TARGET" || fail "không có tiến trình $TARGET"
    fi
    ;;
isolate_host)
    MIPS=$(manager_ips)
    [ -n "$MIPS" ] || fail "không xác định được IP của wazuh-manager, không cô lập (sẽ mất kênh điều khiển)"
    for T in iptables ip6tables; do
        command -v "$T" >/dev/null 2>&1 || continue
        for C in SIEM_ISOLATE_IN SIEM_ISOLATE_OUT; do "$T" -N "$C" 2>/dev/null; "$T" -F "$C"; done
        "$T" -A SIEM_ISOLATE_IN -i lo -j ACCEPT
        "$T" -A SIEM_ISOLATE_OUT -o lo -j ACCEPT
        for m in $MIPS; do
            [ "$(ipt "$m")" = "$T" ] || continue
            "$T" -A SIEM_ISOLATE_IN -s "$m" -j ACCEPT
            "$T" -A SIEM_ISOLATE_OUT -d "$m" -j ACCEPT
        done
        "$T" -A SIEM_ISOLATE_IN -j DROP
        "$T" -A SIEM_ISOLATE_OUT -j DROP
        "$T" -C INPUT -j SIEM_ISOLATE_IN 2>/dev/null || "$T" -I INPUT -j SIEM_ISOLATE_IN
        "$T" -C OUTPUT -j SIEM_ISOLATE_OUT 2>/dev/null || "$T" -I OUTPUT -j SIEM_ISOLATE_OUT
    done
    log success "đã cô lập máy, chỉ giữ kết nối tới wazuh-manager ($(echo $MIPS))"
    ;;
unisolate_host)
    for T in iptables ip6tables; do
        command -v "$T" >/dev/null 2>&1 || continue
        while "$T" -D INPUT -j SIEM_ISOLATE_IN 2>/dev/null; do :; done
        while "$T" -D OUTPUT -j SIEM_ISOLATE_OUT 2>/dev/null; do :; done
        for C in SIEM_ISOLATE_IN SIEM_ISOLATE_OUT; do "$T" -F "$C" 2>/dev/null; "$T" -X "$C" 2>/dev/null; done
    done
    log success "đã bỏ cô lập"
    ;;
*)
    fail "loại lệnh không hỗ trợ"
    ;;
esac
exit 0
