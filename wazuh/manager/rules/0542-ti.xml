<!--
  TI-001 (kết nối với IOC trong Threat Intelligence), chạy BÓNG. Dải ID 107000-107999.
  KHÔNG ĐỔI TÊN FILE: tên phải xếp SAU 0541-network.xml (chứa 103000, 103003, 103004), 0475-suricata_rules.xml (86601) và 0540-pfsense_rules.xml (87701); Wazuh nạp theo tên file và bỏ rule có
  if_sid chưa tồn tại. Vì vậy file này không mang số 0107 như bảng kế hoạch (cùng lý do với 0541-network.xml); ID_RANGES trong server/siem/wazuh_rules.py dùng tên 0542-ti.xml.

  Rule cũ dựa vào threat.matched do pipeline analyzer gắn (IP / domain / hash từ file config/intel và feed MISP). Ở Wazuh chỉ phần IP làm được bằng danh sách CDB:
  SOAR mỗi chu kỳ đồng bộ MISP (MISP_INTERVAL_MINUTES) đổi IOC loại ip còn hạn thành danh sách `etc/lists/siem-misp-ip` (server/siem/pipeline/misp_cdb.py, tools/misp_to_cdb.py),
  đẩy lên bằng Wazuh API rồi nạp lại analysisd. CIDR /24-/31 được triển khai thành từng địa chỉ: Wazuh 4.14.8 không khớp khóa CIDR trong CDB (đã thử, cả address_match_key).
  Danh sách khai báo trong ossec.conf; entrypoint tạo file giữ chỗ (một dòng 240.0.0.0:empty, API Wazuh từ chối file rỗng) nên analysisd chạy được cả khi chưa có IOC.
  KHÔNG đụng danh sách gốc etc/lists/malicious-ioc/malicious-ip của Wazuh (R50): 99915 / 99916 và NET-004 (103004) dùng nó.
  Domain và hash từ MISP CHƯA có rule ở đây (rule gốc 99917 / 99918 dùng danh sách domain gốc; hash cần decoder sysmon / syscheck), xem task-11-report.

  Phạm vi nguồn (rule không điều kiện sẽ chặn cả họ rule gốc, nên chọn các cha có địa chỉ IP trong sự kiện):
    - firewall pf / filterlog (OPNsense qua agent hoặc syslog 514): con của 87701 (block) và 103000 (pass, bộ đếm của 0541-network.xml), và của 103003 (NET-003);
      rule cuối của event đổi sang TI-001 nên event đó KHÔNG vào lịch sử đếm của NET-001 / NET-005 / 87702: chấp nhận được vì TI-001 đã báo từng event của nguồn IOC (giống mục 5 đầu 0541-network.xml);
    - Suricata (eve.json): con của 86601 và của 103004.
  Chưa phủ: sshd, web access log, DNS... (cần cha riêng cho từng nguồn; thêm khi có nhu cầu).

  Thứ tự anh em cùng cha (thử trên 4.14.8): rule LEVEL CAO hơn thắng, bằng level thì rule nạp trước thắng; rule gốc (ruleset/rules) nạp trước rule của repo. Vì vậy:
    - TI-001 firewall level 10 ngang NET-003 (103003, nạp trước) nên NET-003 thắng khi trùng; 107003 là CON của 103003 để vẫn ra TI-001 (mô tả nêu IOC).
    - Suricata: 99915 / 99916 (level 9, danh sách gốc) thua mọi rule level 10, nên 107004 / 107005 loại IP nằm trong danh sách gốc để rule IOC gốc giữ ngữ cảnh, và 103004 (NET-004, level 10, đã loại IP danh sách gốc)
      thắng 107004 / 107005 ở severity <= 2, vì thế severity <= 2 xử lý bằng 107006 / 107007 là CON của 103004, còn 107004 / 107005 chỉ nhận severity khác 0-2.
    - GIỚI HẠN analysisd 4.14.8: rule có từ 3 thẻ <list> trở lên bị xét sai (thẻ đầu bị bỏ qua / kết quả lẫn), nên mỗi rule dưới đây chỉ có tối đa 2 thẻ <list>. Hệ quả: nguồn nằm trong danh sách MISP
      còn đích nằm trong danh sách gốc (hoặc ngược lại) thì TI-001 (level 10) thắng 99915 / 99916 (level 9); chỉ IP có ở CẢ HAI danh sách ở CÙNG trường mới nhường rule gốc.
  Trường dùng: srcip / dstip (firewall, decoder pf), src_ip / dest_ip (Suricata, trường json). Dùng match_key / not_match_key (khớp chuỗi chính xác, như 99915 và 103004).
-->
<group name="local,siem-xdr,">
  <!-- TI-001 firewall: IP NGUỒN nằm trong danh sách IOC (nguồn ngoài đang chạm vào mạng) -->
  <rule id="107001" level="10">
    <if_sid>87701, 103000</if_sid>
    <list field="srcip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <description>TI-001 IP nguồn $(srcip) nằm trong danh sách IOC (MISP) - firewall $(action)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <!-- TI-001 firewall: IP ĐÍCH nằm trong danh sách IOC (máy nội bộ nối ra máy chủ độc hại / C2) -->
  <rule id="107002" level="10">
    <if_sid>87701, 103000</if_sid>
    <list field="dstip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <description>TI-001 IP đích $(dstip) nằm trong danh sách IOC (MISP) - firewall $(action)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <!-- TI-001 firewall: nguồn IOC vào cổng quản trị (NET-003 đã báo; con của nó để mô tả nêu IOC) -->
  <rule id="107003" level="10">
    <if_sid>103003</if_sid>
    <list field="srcip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <description>TI-001 IP nguồn $(srcip) nằm trong danh sách IOC (MISP) vào cổng quản trị $(dstport)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <!-- TI-001 Suricata, severity khác 0-2 (NET-004 không nhận): IP nguồn / đích trong danh sách IOC MISP và không nằm trong danh sách gốc (khi đó 99915 / 99916 giữ ngữ cảnh) -->
  <rule id="107004" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity" type="pcre2" negate="yes">^[0-2]$</field>
    <list field="src_ip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <list field="src_ip" lookup="not_match_key">etc/lists/malicious-ioc/malicious-ip</list>
    <description>TI-001 Cảnh báo Suricata từ IP nguồn $(src_ip) nằm trong danh sách IOC (MISP): $(alert.signature)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <rule id="107005" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity" type="pcre2" negate="yes">^[0-2]$</field>
    <list field="dest_ip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <list field="dest_ip" lookup="not_match_key">etc/lists/malicious-ioc/malicious-ip</list>
    <description>TI-001 Cảnh báo Suricata tới IP đích $(dest_ip) nằm trong danh sách IOC (MISP): $(alert.signature)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <!-- TI-001 Suricata, severity 0-2: con của NET-004 (103004 đã loại IP danh sách gốc), nên không cần loại lại -->
  <rule id="107006" level="10">
    <if_sid>103004</if_sid>
    <list field="src_ip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <description>TI-001 Cảnh báo Suricata mức cao từ IP nguồn $(src_ip) nằm trong danh sách IOC (MISP): $(alert.signature)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>

  <rule id="107007" level="10">
    <if_sid>103004</if_sid>
    <list field="dest_ip" lookup="match_key">etc/lists/siem-misp-ip</list>
    <description>TI-001 Cảnh báo Suricata mức cao tới IP đích $(dest_ip) nằm trong danh sách IOC (MISP): $(alert.signature)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <info type="text">shadow_since=2026-11-03</info>
    <group>siem,threat_intel,shadow,legacy_TI-001,</group>
  </rule>
</group>
