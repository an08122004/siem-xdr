<!--
  Rule xác thực (AUTH-001..006 của bộ rule cũ), chạy BÓNG. Dải ID 101000-101999. AUTH-005 dùng thẳng rule gốc 5902 (không viết lại).
  Phạm vi: sshd/sudo qua syslog. Nhật ký đăng nhập console NAY CŨNG đi qua Wazuh (agent 000, location /var/log/siem-console/console.json),
  nhưng rule cho nó chưa viết (lượt B) nên AUTH-002/003 tạm chưa phủ chúng.
  Thứ tự file quan trọng: các rule dùng cùng event chỉ rule đứng trước báo, nên AUTH-003 > AUTH-001 > bộ đếm 600s (101010).
-->
<group name="local,siem-xdr,">
  <!-- AUTH-000: bộ đếm chung cho mọi thất bại SSH (5760 user có thật, 5710 user không tồn tại), nên 3 user thật + 3 user giả vẫn cộng dồn.
       Level 2 < log_alert_level (3) nên không ra alert.
       HỆ QUẢ: alert từng lần thất bại của rule gốc (5760/5710, level 5) nay được ghi là 101000 level 2 (không vào alerts.json); các rule gốc đếm if_matched_sid 5760/5710
       (5763, 5712; 8 lần/120s, level 10) mất lịch sử đếm và KHÔNG còn báo.
       Đã thử khôi phục trên 4.14.8, không được: (1) đếm 8/120s trên 101000 song song 101001/101010 không chạy vì rule frequency khi báo "tiêu" các event đã đếm;
       (2) rule nối vào 101010 bằng if_matched_sid làm 101002 hết nhận 101010 hoặc chính nó không báo. Phần hở: nhịp 4-5 lần sai/phút từ một IP (dưới 5/60s của AUTH-001 cũ,
       trên 8/120s của gốc): chỉ còn 101010 (level 2, im) và 101002 nếu sau đó đăng nhập được. Rule YAML cũ không có ngưỡng này nên không thua rule cũ, chỉ thua ruleset gốc;
       Task 12 (tuning) cân nhắc lại. Từ đây, event bị ghi nhận là 101000 (không còn là 5760/5710) -> mọi bộ đếm dùng if_matched_sid 101000. -->
  <rule id="101000" level="2">
    <if_sid>5760, 5710</if_sid>
    <description>AUTH-000 Thất bại đăng nhập SSH (bộ đếm chung cho AUTH-001/002/003)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-001,</group>
  </rule>

  <!-- AUTH-003: password spraying, 5 tài khoản khác nhau từ một IP trong 2 phút. user của sshd nằm ở dstuser (user thật) hoặc srcuser (user không tồn tại):
       khai cả hai different_*; trường vắng mặt luôn tính là "khác" nên chỉ trường có giá trị quyết định. -->
  <!-- Giới hạn (spike S4): đếm "event trước có user khác event hiện tại", không đếm số user phân biệt; 2 user xen kẽ vẫn báo sau ~2N event.
       Cũng vì vậy user thật "a" và user giả "a" xen nhau được tính là khác nhau. -->
  <rule id="101003" level="10" frequency="5" timeframe="120" ignore="120">
    <if_matched_sid>101000</if_matched_sid>
    <same_source_ip />
    <different_user />
    <different_srcuser />
    <description>AUTH-003 Password spraying: $(srcip) thử &gt;= 5 tài khoản khác nhau trong 2 phút</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-003,auth_bf_stage,</group>
  </rule>

  <!-- AUTH-001: >= 5 lần sai (user thật hoặc không tồn tại) từ cùng IP trong 60s. -->
  <rule id="101001" level="10" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>101000</if_matched_sid>
    <same_source_ip />
    <description>AUTH-001 Brute-force đăng nhập: &gt;= 5 lần thất bại từ $(srcip) trong 60 giây</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-001,auth_bf_stage,</group>
  </rule>

  <!-- Bộ đếm riêng cho AUTH-002: >= 5 lần sai trong 600s (rule cũ cho phép brute-force chậm). Level 2, không ra alert. Đứng sau 101001 nên khi 5 lần sai
       dồn trong 60s thì 101001 báo; AUTH-002 nối theo nhóm auth_bf_stage (có ở 101001, 101003, 101010) nên chuỗi nào cũng đủ. -->
  <rule id="101010" level="2" frequency="5" timeframe="600">
    <if_matched_sid>101000</if_matched_sid>
    <same_source_ip />
    <description>AUTH-002 Chuỗi thất bại đăng nhập &gt;= 5 lần trong 10 phút (bước đầu của brute-force thành công)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-002,auth_bf_stage,</group>
  </rule>

  <!-- AUTH-002: đăng nhập thành công (5715) cùng IP trong 10 phút sau chuỗi thất bại (brute-force, spraying hoặc chậm). Nối bằng nhóm, không dùng frequency
       nên không dính giới hạn if_matched_group của spike. Đứng trước AUTH-004: root đăng nhập sau brute-force ra 101002 (critical), không ra 101004; chấp nhận được vì mức nặng hơn. -->
  <rule id="101002" level="12" timeframe="600">
    <if_sid>5715</if_sid>
    <if_matched_group>auth_bf_stage</if_matched_group>
    <same_source_ip />
    <description>AUTH-002 Brute-force THÀNH CÔNG: đăng nhập được từ $(srcip) sau chuỗi thất bại (khả năng cao tài khoản bị chiếm)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-002,</group>
  </rule>

  <!-- AUTH-004: SSH root thành công. -->
  <rule id="101004" level="7">
    <if_sid>5715</if_sid>
    <user>^root$</user>
    <description>AUTH-004 Đăng nhập SSH bằng root từ $(srcip)</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-004,</group>
  </rule>

  <!-- AUTH-006: sudo mở shell/su, hoặc sudo thất bại. Con của các rule sudo gốc (đứng sau chúng mới thấy được).
       Giới hạn: sudo thất bại qua PAM ("pam_unix(sudo:auth): authentication failure") đi vào nhóm PAM gốc (5503), không phải rule sudo -> chưa phủ;
       trường hợp phổ biến còn lại "incorrect password attempt" thì có. -->
  <rule id="101006" level="7">
    <if_sid>5401, 5402, 5403, 5405, 5406, 5407</if_sid>
    <regex type="pcre2">incorrect password attempt|NOT in sudoers|command not allowed|COMMAND=\S*/(ba|z|da)?sh(\s|$)|COMMAND=(\S*/)?su(\s+-?)?\s*$|COMMAND=.*\s-i$</regex>
    <description>AUTH-006 Sudo mở shell root hoặc sudo thất bại: $(dstuser)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <info type="text">shadow_since=2026-10-31</info>
    <group>siem,auth,shadow,legacy_AUTH-006,</group>
  </rule>

</group>
