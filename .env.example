# SOC Platform — cấu hình KHÔNG bí mật. Bí mật (mật khẩu, key) nằm trong thư mục secrets/:
#   python tools/init_secrets.py
# Tên project Compose mặc định là soc-platform (name: trong docker-compose.yml). Hệ thống cài trước 14/10/2026 (tên cũ
# siem-xdr, dữ liệu trong volume siem-xdr_*): chạy python tools/migrate_project.py, hoặc giữ tên cũ bằng dòng dưới.
# COMPOSE_PROJECT_NAME=siem-xdr
# IP của máy chạy docker để truy cập SOC console (https://<IP>:8000) từ máy khác (ghi vào chứng chỉ TLS),
# nhiều IP cách nhau bằng dấu phẩy. Đổi giá trị này thì phải xóa volume certs để sinh lại chứng chỉ.
# (Wazuh agent kết nối tới wazuh-manager qua 1514/1515, không cần giá trị này.)
MANAGER_TLS_IPS=

# Đăng nhập SOC console (tài khoản riêng; lần đầu: admin / secrets/console_admin_password) — bỏ # để đổi mặc định
# CONSOLE_IDLE_MINUTES=30             # không thao tác quá N phút -> phải đăng nhập lại
# CONSOLE_SESSION_HOURS=8             # phiên dài tối đa N giờ
# CONSOLE_MAX_FAILURES=5              # sai N lần trong 15 phút (theo tài khoản hoặc IP) -> khóa 15 phút
# Grafana nằm sau manager và dùng chung phiên console. Đổi nếu truy cập bằng tên máy / IP khác localhost:
# GRAFANA_ROOT_URL=https://localhost:8000/grafana/

# SOAR — lệnh phản ứng gửi xuống agent qua Wazuh API (user siem-soar, mật khẩu trong secrets/wazuh_api_password)
SOAR_AUTO_RESPONSE=true
SOAR_WHITELIST=127.0.0.0/8
# SOAR_MAX_AUTO_KILLS=10              # tối đa N lệnh kill tự động / agent / 60 giây, quá thì chờ analyst; 0 = tắt
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFY_COOLDOWN_SECONDS=300         # mỗi (rule, thực thể) tối đa 1 thông báo / N giây, phần còn lại gộp; 0 = tắt

# Cảnh báo của ruleset Wazuh chuyển thành alert (WZH-<id>) — xem README mục 3
# WAZUH_ALERT_GROUPS=syscheck,rootcheck,vulnerability-detector,virustotal,yara
# WAZUH_ALERT_MIN_LEVEL=7             # nhóm trên: từ level này
# WAZUH_ALERT_ANY_LEVEL=12            # mọi nhóm: từ level này

# Giữ event bao nhiêu ngày (ILM xóa index siem-events-* cũ hơn; chạy lại es-setup sau khi đổi)
# EVENTS_RETENTION_DAYS=30

# ML — tạm dừng (tỉ lệ báo nhầm cao, xem README)
ML_ENABLED=false

# AI hỗ trợ viết rule (profile ai) — bỏ dấu # để đổi giá trị mặc định, xem README mục 5
# AI_MODEL=qwen3.5:9b                 # đã đo: qwen2.5-coder:7b, qwen3:8b, Foundation-Sec-1.1-8B kém hơn (AI-README mục 10)
# AI_THINK=false                      # model có chế độ suy nghĩ (qwen3, qwen3.5): true = bật, chậm hơn nhiều
# OLLAMA_MODELS_DIR=D:/ollama-models  # nơi lưu model Ollama (mặc định: volume docker "ollama"); mỗi model 5-7 GB
# AI_INTERVAL_MINUTES=60              # chu kỳ tự chạy; 0 = chỉ chạy khi analyst bấm trên console
# AI_LOOKBACK_DAYS=30                 # lấy nhãn false positive / case thật trong N ngày
# AI_REPLAY_DAYS=7                    # replay event thật N ngày để ước lượng số alert
# AI_MIN_FALSE_POSITIVES=3            # rule có >= N báo nhầm mới đề xuất ngoại lệ
# AI_MIN_GROUP_EVENTS=20              # nhóm event chưa có rule cần >= N event
# AI_MAX_NEW_RULE_ALERTS_PER_DAY=20   # rule mới sinh quá N alert/ngày khi replay -> loại
# AI_MAX_PROPOSALS_PER_RUN=5
# AI_SIGMAHQ_CANDIDATES=true          # rule SigmaHQ cùng kỹ thuật làm vế ứng viên (đo như vế của model)
# AI_KNOWLEDGE_ROUND=true             # hỏi model các công cụ / cách làm khác của kỹ thuật mà mẫu chưa có
# AI_REFINE_ROUNDS=6                  # rule từ dataset: tối đa N lượt LLM bổ sung mẫu cho biến thể còn sót
# RULES_CATALOG_SECONDS=60            # cập nhật danh mục Thư viện rule (rule + đề xuất AI) mỗi N giây
