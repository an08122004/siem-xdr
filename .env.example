# Cấu hình KHÔNG bí mật. Bí mật (mật khẩu, key) nằm trong thư mục secrets/:
#   python tools/init_secrets.py
# IP của máy chạy docker mà agent ở máy khác dùng để kết nối manager (ghi vào chứng chỉ TLS),
# nhiều IP cách nhau bằng dấu phẩy. Đổi giá trị này thì phải xóa volume certs để sinh lại chứng chỉ.
MANAGER_TLS_IPS=

# SOAR
SOAR_AUTO_RESPONSE=true
SOAR_WHITELIST=127.0.0.0/8
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ML — tạm dừng (tỉ lệ báo nhầm cao, xem README)
ML_ENABLED=false

# AI hỗ trợ viết rule (profile ai) — bỏ dấu # để đổi giá trị mặc định, xem README mục 5
# AI_MODEL=qwen2.5-coder:7b
# AI_INTERVAL_MINUTES=60              # chu kỳ tự chạy; 0 = chỉ chạy khi analyst bấm trên console
# AI_LOOKBACK_DAYS=30                 # lấy nhãn false positive / case thật trong N ngày
# AI_REPLAY_DAYS=7                    # replay event thật N ngày để ước lượng số alert
# AI_MIN_FALSE_POSITIVES=3            # rule có >= N báo nhầm mới đề xuất ngoại lệ
# AI_MIN_GROUP_EVENTS=20              # nhóm event chưa có rule cần >= N event
# AI_MAX_NEW_RULE_ALERTS_PER_DAY=20   # rule mới sinh quá N alert/ngày khi replay -> loại
# AI_MAX_PROPOSALS_PER_RUN=5
